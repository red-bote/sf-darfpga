#!/bin/bash
# Generic machine setup script template.
#
# Setup wrapper for the <game> Basys3 port. Delegates to the shared
# darfpga_setup() in sf-darfpga/tools/lib/darfpga-setup.sh (fetch/verify the
# SourceForge archive, extract it, apply fix patches — excluding the
# *_de10_lite_to_basys3.patch and *scandoubler_fix.patch provenance/timing
# patches, which that shared function hardcodes as never-apply-to-pristine
# — then run contrib/tools/prep_roms.sh).
#
# Roms and the generated PROM VHDL stay local (never distributed).
#
# Substitute: <game> (snake_case), <src_dir> (extracted archive dir),
# <url> (SourceForge archive URL), <sha256> (archive SHA-256).
# Copy to <Machine>-by-Dar/contrib/tools/setup_<game>.sh.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../.." && pwd)"
. "$ROOT/../tools/lib/darfpga-setup.sh"

darfpga_setup \
  --root    "$ROOT" \
  --src-dir <src_dir> \
  --url     "<url>" \
  --sha256  <sha256>
