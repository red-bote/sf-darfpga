#!/bin/bash
# Generic make_basys3_bitstream.sh template.
#
# Bitstream wrapper for the <game> Basys3 port. Delegates to the shared
# darfpga_build_bitstream() in sf-darfpga/tools/lib/darfpga-bitstream.sh.
#
# Usage: make_<game>_basys3_bitstream.sh {synth|bitstream}
#
# The project must already have its sources in place: run `make setup`,
# `make clk_wiz` and `make patch` first (all covered by `make synth`).
#
# Substitute: <game> (snake_case), <src_dir> (extracted archive dir),
# <TOP_ENTITY> (Basys3 top entity, e.g. galaga_basys3).
# Copy to <Machine>-by-Dar/contrib/basys3/tools/make_<game>_basys3_bitstream.sh.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
. "$ROOT/../tools/lib/darfpga-bitstream.sh"

darfpga_build_bitstream \
  --root       "$ROOT" \
  --src-dir    <src_dir> \
  --top-entity <TOP_ENTITY> \
  -- "${1:-}"
