#!/bin/bash
# Generic make_de10_lite_to_basys3_patch.sh template.
#
# Patch wrapper for the <game> Basys3 port. Delegates to the shared
# darfpga_place_top_level() in sf-darfpga/tools/lib/darfpga-patch.sh, which
# places the tracked contrib/basys3/code/<TOP_ENTITY>.vhd into the Vivado
# project sources and regenerates its provenance patch
# (contrib/basys3/code/<game>_de10_lite_to_basys3.patch, a diff against the
# pristine upstream <DE10_TOP> — documentation only, not consumed by the
# build).
#
# Author the top-level VHDL itself as a real file at
# contrib/basys3/code/<TOP_ENTITY>.vhd (see the <Machine>-by-Dar/PORTING_SPEC.md
# and the external-IO convention in the root PORTING_SPEC.md §3; format it
# with sf-darfpga/tools/vhdl_formatter.py). If the port imports a
# scandoubler, the VHDL must include the scandoubler wiring (component +
# instance + clock derivation).
#
# Requires the pristine tree (run `make setup` first).
#
# Substitute: <game> (snake_case), <src_dir> (extracted archive dir),
# <DE10_TOP> (upstream DE10-lite top filename, e.g. galaga_de10_lite.vhd),
# <TOP_ENTITY> (Basys3 top entity, e.g. galaga_basys3).
# Copy to <Machine>-by-Dar/contrib/basys3/tools/make_de10_lite_to_basys3_patch.sh.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
. "$ROOT/../tools/lib/darfpga-patch.sh"

darfpga_place_top_level \
  --root       "$ROOT" \
  --src-dir    <src_dir> \
  --de10-top   <DE10_TOP> \
  --top-entity <TOP_ENTITY>
