---------------------------------------------------------------------------------
-- Basys3 top level for <game> by Dar (darfpga@aol.fr), http://darfpga.blogspot.fr
--
-- Basys3 port of <DE10_TOP>. Skeleton from sf-darfpga/wip/machine; reference model
-- Pooyan-by-Dar/contrib/basys3/code/pooyan_basys3.vhd. Recipe: sf-darfpga
-- PORTING_SPEC.md section 4. Replace every TODO, then delete this paragraph.
--
--  - Single clock domain: clk_wiz_0 (100 MHz in) gives clk_core; CPU, pixel, sound
--    and PWM rates are clock enables (TODO: rates, PORTING_SPEC.md section 5)
--  - Keyboard: onboard USB-HID (io_ps2_keyboard on clk_core), MAME default keys
--    decoded here (F0 = release, E0 ignored)
--  - Joystick on JXADC pins 1/2/3/4/7 = right/left/down/up/fire, active low
--  - btnC = reset, btnU/btnD = coin, btnL/btnR = start
--  - PS/2, JXADC and buttons pass 2-FF synchronizers on clk_core
--  - Audio: PmodAMP2 on JA pins 1/2/4; sw15 up = audio off, sw14 up = gain
--  - Video: 31 kHz VGA via the MiST scandoubler; sw13 up = 15 kHz TV
--    (native-video cores: drop the scandoubler, drive tv15Khz_mode <= sw(13))
--  - DIP switches on spare switches, switch down = Dar's DE10 value
---------------------------------------------------------------------------------
-- Educational use only
-- Do not redistribute synthetized file with roms
-- Do not redistribute roms whatever the form
-- Use at your own risk
---------------------------------------------------------------------------------

library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity <TOP_ENTITY> is
port(
 clk              : in  std_logic;
 sw               : in  std_logic_vector(15 downto 0);
 btnC             : in  std_logic;  -- reset
 btnU             : in  std_logic;  -- coin
 btnD             : in  std_logic;  -- coin
 btnL             : in  std_logic;  -- 1P start
 btnR             : in  std_logic;  -- 2P start

 JXADC            : in  std_logic_vector(4 downto 0);  -- joystick
 ps2_clk          : in  std_logic;
 ps2_dat          : in  std_logic;

 O_PMODAMP2_AIN   : out std_logic;
 O_PMODAMP2_GAIN  : out std_logic;
 O_PMODAMP2_SHUTD : out std_logic;

 vga_r            : out std_logic_vector(3 downto 0);
 vga_g            : out std_logic_vector(3 downto 0);
 vga_b            : out std_logic_vector(3 downto 0);
 vga_hs           : out std_logic;
 vga_vs           : out std_logic
);
end <TOP_ENTITY>;

architecture struct of <TOP_ENTITY> is

 component scandoubler
   port (
     clk_sys   : in  std_logic;
     scanlines : in  std_logic_vector(1 downto 0);
     ce_x1     : in  std_logic;
     ce_x2     : in  std_logic;
     hs_in     : in  std_logic;
     vs_in     : in  std_logic;
     r_in      : in  std_logic_vector(5 downto 0);
     g_in      : in  std_logic_vector(5 downto 0);
     b_in      : in  std_logic_vector(5 downto 0);
     hs_out    : out std_logic;
     vs_out    : out std_logic;
     r_out     : out std_logic_vector(5 downto 0);
     g_out     : out std_logic_vector(5 downto 0);
     b_out     : out std_logic_vector(5 downto 0)
   );
 end component;

 signal clk_core    : std_logic;
 signal mmcm_locked : std_logic;
 signal reset_s     : std_logic_vector(1 downto 0) := "11";
 signal reset       : std_logic;
 attribute ASYNC_REG : string;
 attribute ASYNC_REG of reset_s : signal is "TRUE";

 -- Clock enables (TODO: derive from clk_core for the core's CPU/pixel/sound rates)
 signal ce_pix      : std_logic := '0';  -- pixel rate, scandoubler ce_x1
 signal ce_pix2     : std_logic := '0';  -- exactly 2 x ce_pix, scandoubler ce_x2

 -- PS/2, JXADC(4:0) and btnD/btnR/btnL/btnU, 2-FF synchronized (index 1 = output)
 signal ps2_clk_s, ps2_dat_s : std_logic_vector(1 downto 0) := "11";
 type in_sync_t is array (1 downto 0) of std_logic_vector(8 downto 0);
 signal in_s : in_sync_t := (others => (others => '1'));
 attribute ASYNC_REG of ps2_clk_s, ps2_dat_s, in_s : signal is "TRUE";
 signal jxadc_s : std_logic_vector(4 downto 0);
 signal btnU_s, btnD_s, btnL_s, btnR_s : std_logic;

 -- Keyboard: 0 up, 1 down, 2 left, 3 right, 4 button 1, 5 button 2,
 -- 6 coin (5/6), 7 start 1, 8 start 2 (TODO: extend per PORTING_SPEC.md section 3.1)
 signal kbd_intr     : std_logic;
 signal kbd_scancode : std_logic_vector(7 downto 0);
 signal kbd_rel      : std_logic := '0';
 signal kbd_key      : std_logic_vector(8 downto 0) := (others => '0');

 -- Merged core inputs, active high (TODO: invert where the core input is active low)
 signal in_up, in_down, in_left, in_right, in_fire : std_logic;
 signal in_coin, in_start1, in_start2              : std_logic;

 -- DIP switches (PORTING_SPEC.md section 3.2): switch down = Dar's DE10 value.
 -- TODO: one constant + signal per DIP input; wire whole settings only.
 constant DIP1_DEFAULT : std_logic_vector(7 downto 0) := x"FF";
 signal dip1 : std_logic_vector(7 downto 0);

 -- Core video and audio (TODO: widths from the core entity)
 signal r, g, b       : std_logic_vector(2 downto 0) := (others => '0');
 signal hsync, vsync  : std_logic := '1';
 signal csync, blankn : std_logic := '1';
 signal audio         : std_logic_vector(10 downto 0) := (others => '0');

 signal video_ri, video_gi, video_bi : std_logic_vector(5 downto 0);
 signal vga_ro, vga_go, vga_bo       : std_logic_vector(5 downto 0);
 signal vga_hs_o, vga_vs_o           : std_logic;

 signal pwm_accumulator : unsigned(12 downto 0) := (others => '0');
 signal audio_ext       : std_logic_vector(12 downto 0);  -- "00" & audio (no & inside a conversion)

begin

-- 100 MHz -> clk_core (single output, contrib/basys3/vivado/make_clk_wiz_0.sh)
clocks : entity work.clk_wiz_0
port map(
 clk_in1  => clk,
 clk_out1 => clk_core,
 reset    => btnC,
 locked   => mmcm_locked
);

-- Core held in reset until the MMCM locks; asynchronous assert, synchronous release.
process (clk_core, btnC, mmcm_locked)
begin
  if btnC = '1' or mmcm_locked = '0' then
    reset_s <= "11";
  elsif rising_edge(clk_core) then
    reset_s <= reset_s(0) & '0';
  end if;
end process;
reset <= reset_s(1);

-- TODO: clock-enable generation (ce_pix, ce_pix2, CPU and sound enables).

-- Input synchronizers (2-FF) into clk_core
process (clk_core)
begin
  if rising_edge(clk_core) then
    ps2_clk_s <= ps2_clk_s(0) & ps2_clk;
    ps2_dat_s <= ps2_dat_s(0) & ps2_dat;
    in_s(0)   <= btnD & btnR & btnL & btnU & JXADC;
    in_s(1)   <= in_s(0);
  end if;
end process;

jxadc_s <= in_s(1)(4 downto 0);
btnU_s  <= in_s(1)(5);
btnL_s  <= in_s(1)(6);
btnR_s  <= in_s(1)(7);
btnD_s  <= in_s(1)(8);

keyboard : entity work.io_ps2_keyboard
port map (
  clk       => clk_core,
  kbd_clk   => ps2_clk_s(1),
  kbd_dat   => ps2_dat_s(1),
  interrupt => kbd_intr,
  scancode  => kbd_scancode
);

-- MAME default keys (PS/2 set 2). F0 marks a release; E0 is ignored (keypad
-- 8/2/4/6 alias the arrows, Right Ctrl/Alt alias Left Ctrl/Alt).
-- Toggles: flip on make, ignore typematic repeat (keep a held bit per key).
process (clk_core)
begin
  if rising_edge(clk_core) then
    if kbd_intr = '1' then
      if kbd_scancode = x"F0" then
        kbd_rel <= '1';
      elsif kbd_scancode /= x"E0" then
        kbd_rel <= '0';
        if kbd_scancode = x"75" then kbd_key(0) <= not kbd_rel; end if; -- up arrow
        if kbd_scancode = x"72" then kbd_key(1) <= not kbd_rel; end if; -- down arrow
        if kbd_scancode = x"6B" then kbd_key(2) <= not kbd_rel; end if; -- left arrow
        if kbd_scancode = x"74" then kbd_key(3) <= not kbd_rel; end if; -- right arrow
        if kbd_scancode = x"14" then kbd_key(4) <= not kbd_rel; end if; -- left ctrl : button 1
        if kbd_scancode = x"11" then kbd_key(5) <= not kbd_rel; end if; -- left alt : button 2
        if kbd_scancode = x"2E" or kbd_scancode = x"36" then kbd_key(6) <= not kbd_rel; end if; -- 5 / 6 : coin
        if kbd_scancode = x"16" then kbd_key(7) <= not kbd_rel; end if; -- 1 : start 1
        if kbd_scancode = x"1E" then kbd_key(8) <= not kbd_rel; end if; -- 2 : start 2
      end if;
    end if;
  end if;
end process;

-- Merge keyboard, JXADC (active low, inverted) and buttons. Debounce only where the
-- core edge-detects at full clock rate (PORTING_SPEC.md section 4.4).
-- Joystick combos only with user approval.
in_up     <= kbd_key(0) or not jxadc_s(3);  -- JXADC4
in_down   <= kbd_key(1) or not jxadc_s(2);  -- JXADC3
in_left   <= kbd_key(2) or not jxadc_s(1);  -- JXADC2
in_right  <= kbd_key(3) or not jxadc_s(0);  -- JXADC1
in_fire   <= kbd_key(4) or not jxadc_s(4);  -- JXADC7
in_coin   <= kbd_key(6) or btnU_s or btnD_s;
in_start1 <= kbd_key(7) or btnL_s;
in_start2 <= kbd_key(8) or btnR_s;

-- DIP switches (TODO: assign each DIP input; bits and switches per section 3.2)
dip1 <= DIP1_DEFAULT xor (x"0" & sw(11 downto 8));

-- TODO: core instance. Keep Dar's port map; connect clk_core, enables, reset,
-- in_* (P2 mirrors P1), dip*, and the video/audio signals above. Route every
-- expression actual through a signal.
-- core : entity work.<core_entity>
-- port map( ... );

-- 31 kHz VGA via the MiST scandoubler; RGB gated on blankn, padded to 6 bits.
video_ri <= (r & r)     when blankn = '1' else "000000";
video_gi <= (g & g)     when blankn = '1' else "000000";
video_bi <= (b & b)     when blankn = '1' else "000000";

scandoubler_inst : scandoubler
port map(
 clk_sys   => clk_core,
 scanlines => "00",
 ce_x1     => ce_pix,
 ce_x2     => ce_pix2,
 hs_in     => hsync,
 vs_in     => vsync,
 r_in      => video_ri,
 g_in      => video_gi,
 b_in      => video_bi,
 hs_out    => vga_hs_o,
 vs_out    => vga_vs_o,
 r_out     => vga_ro,
 g_out     => vga_go,
 b_out     => vga_bo
);

-- sw13: 0 = 31 kHz VGA (scandoubler), 1 = 15 kHz TV (native RGB, csync on HS, VS high)
vga_r  <= vga_ro(5 downto 2) when sw(13) = '0' else video_ri(5 downto 2);
vga_g  <= vga_go(5 downto 2) when sw(13) = '0' else video_gi(5 downto 2);
vga_b  <= vga_bo(5 downto 2) when sw(13) = '0' else video_bi(5 downto 2);
vga_hs <= vga_hs_o           when sw(13) = '0' else csync;
vga_vs <= vga_vs_o           when sw(13) = '0' else '1';

-- PWM audio. TODO: replace with Dar's own accumulator (width, scaling, enable).
audio_ext <= "00" & audio;

process (clk_core)
begin
  if rising_edge(clk_core) then
    pwm_accumulator <= ('0' & pwm_accumulator(11 downto 0)) + unsigned(audio_ext);
  end if;
end process;

O_PMODAMP2_AIN   <= pwm_accumulator(12);
O_PMODAMP2_SHUTD <= not sw(15);  -- sw15 up = amp shut down (audio off)
O_PMODAMP2_GAIN  <= not sw(14);  -- sw14 up = gain active (GAIN active low)

end struct;
