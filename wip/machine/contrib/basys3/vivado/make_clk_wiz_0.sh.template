#!/bin/bash
# Generic make_clk_wiz_0.sh template.
#
# Generate the clk_wiz_0 MMCM IP (100 MHz -> <clk_freq> MHz, single output) for the
# <game> Basys3 port and copy its two Verilog files where <TOP_ENTITY>.xpr expects them:
#   sources_1/imports/clk_wiz_0/clk_wiz_0.v
#   sources_1/imports/clk_wiz_0/clk_wiz_0_clk_wiz.v
# The IP is built in a throwaway project under /tmp by the static
# sf-darfpga/tools/vivado/gen_clk_wiz_0.tcl (logs stay outside the repo).
# Frequency choice: sf-darfpga/PORTING_SPEC.md §5.
#
# Substitute: <game>, <src_dir>, <TOP_ENTITY>, <clk_freq> (MHz, e.g. 24.576).
# Copy to <Machine>-by-Dar/contrib/basys3/vivado/make_clk_wiz_0.sh.

set -euo pipefail

FREQ=<clk_freq>

# VIVADO: ENV_VAR -> project default (AGENTS.md "Tool / path resolution"). Inside make,
# VIVADO may hold machine.mk's directory value, so use it only if it is an executable.
vivado=/tools/Xilinx/Vivado/2020.2/bin/vivado
if [ -n "${VIVADO:-}" ] && [ -f "$VIVADO" ] && [ -x "$VIVADO" ]; then vivado="$VIVADO"; fi

HERE="$(cd "$(dirname "$0")" && pwd)"
TCL="$HERE/../../../../tools/vivado/gen_clk_wiz_0.tcl"
XPR_DIR="$(cd "$HERE/../../../<src_dir>/basys3" && pwd)"
CLK_WIZ_IMPORT_DIR="$XPR_DIR/<TOP_ENTITY>.srcs/sources_1/imports/clk_wiz_0"

WORK=/tmp/<game>_clk_wiz
rm -rf "$WORK"
mkdir -p "$WORK"
(cd /tmp && "$vivado" -mode batch -nolog -nojournal -source "$TCL" -tclargs "$WORK" "$FREQ")

mkdir -p "$CLK_WIZ_IMPORT_DIR"
cp "$WORK/clk_wiz_0/clk_wiz_0.v"         "$CLK_WIZ_IMPORT_DIR/"
cp "$WORK/clk_wiz_0/clk_wiz_0_clk_wiz.v" "$CLK_WIZ_IMPORT_DIR/"
rm -rf "$WORK"

MMCM="$CLK_WIZ_IMPORT_DIR/clk_wiz_0_clk_wiz.v"
# Forced solve (only when Vivado's own solve misses the video window,
# PORTING_SPEC.md §5 step 4): replace the generated D / M / O here, e.g.
#   sed -i \
#       -e 's/\.DIVCLK_DIVIDE *( *[0-9]* *)/.DIVCLK_DIVIDE        (6)/' \
#       -e 's/\.CLKFBOUT_MULT_F *( *[0-9.]* *)/.CLKFBOUT_MULT_F      (56.125)/' \
#       -e 's/\.CLKOUT0_DIVIDE_F *( *[0-9.]* *)/.CLKOUT0_DIVIDE_F     (25.375)/' \
#       "$MMCM"
# (Galaga-Midway-by-Dar/contrib/basys3/vivado/make_clk_wiz_0.sh is the worked example.)

echo "MMCM solve (target $FREQ MHz):"
grep -n "DIVCLK_DIVIDE\|CLKFBOUT_MULT_F\|CLKOUT0_DIVIDE_F\|clk_out1__" "$MMCM" | sed 's/^/  /'
echo "Generated clk_wiz_0 IP files:"
ls -l "$CLK_WIZ_IMPORT_DIR"
