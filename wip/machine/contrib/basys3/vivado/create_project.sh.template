#!/bin/bash
# Generic create_project.sh template.
#
# Create the Vivado Basys3 project for the <game> port in the extracted Dar source
# tree from the tracked port assets (same model as every sf-darfpga machine):
#   contrib/basys3/vivado/<TOP_ENTITY>.xpr      -> <src_dir>/basys3/<TOP_ENTITY>.xpr
#   contrib/basys3/vivado/Basys-3-Master.xdc    -> .srcs/constrs_1/imports/digilent-xdc-master/
#   contrib/code/scandoubler.v (MiST path only) -> .srcs/sources_1/imports/mist/, then
#     contrib/code/scandoubler_fix.patch applied to the copy (Vivado rejects the
#     single-value array size; the tracked copy stays pristine).
# The .xpr lists the core sources, PROM VHDL, clk_wiz_0 and the wrapper; clk_wiz_0
# (make_clk_wiz_0.sh) and the wrapper (make patch) are placed by separate steps.
#
# Substitute: <game>, <src_dir>, <TOP_ENTITY>.
# Copy to <Machine>-by-Dar/contrib/basys3/vivado/create_project.sh.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
SRC_DIR="$ROOT/<src_dir>"
CONTRIB="$ROOT/contrib/basys3"

PROJ_DIR="$SRC_DIR/basys3"
CONSTRS_IMPORT="$PROJ_DIR/<TOP_ENTITY>.srcs/constrs_1/imports/digilent-xdc-master"
MIST_IMPORT="$PROJ_DIR/<TOP_ENTITY>.srcs/sources_1/imports/mist"

if [ ! -d "$SRC_DIR" ]; then
    echo "error: source tree not found: $SRC_DIR" >&2
    echo "Run contrib/tools/setup_<game>.sh first." >&2
    exit 1
fi

step() { printf '\n==> %s\n' "$1"; }

step "1/3 Copying <TOP_ENTITY>.xpr"
mkdir -p "$PROJ_DIR" "$CONSTRS_IMPORT"
cp -f "$CONTRIB/vivado/<TOP_ENTITY>.xpr" "$PROJ_DIR/<TOP_ENTITY>.xpr"

step "2/3 Copying Basys-3-Master.xdc"
cp -f "$CONTRIB/vivado/Basys-3-Master.xdc" "$CONSTRS_IMPORT/Basys-3-Master.xdc"

if [ -f "$ROOT/contrib/code/scandoubler.v" ]; then
    step "3/3 Copying scandoubler.v and applying scandoubler_fix.patch"
    mkdir -p "$MIST_IMPORT"
    cp -f "$ROOT/contrib/code/scandoubler.v" "$MIST_IMPORT/scandoubler.v"
    (cd "$PROJ_DIR" && patch -p1 --forward < "$ROOT/contrib/code/scandoubler_fix.patch")
else
    step "3/3 No scandoubler (native video path)"
fi

echo
echo "Project files in place:"
ls -l "$PROJ_DIR/<TOP_ENTITY>.xpr" "$CONSTRS_IMPORT/Basys-3-Master.xdc"
