# Generic Makefile template.
#
# Substitute: <game> (snake_case), <src_dir> (extracted archive dir that `clean`
# removes), <TOP_ENTITY> (usually <game>_basys3), <display_name> (for `make help`),
# <io_summary> (keys, JXADC, buttons, sw13/14/15, DIP switches).
# Copy to <Machine>-by-Dar/Makefile.
#
# All targets (setup create_prj clk_wiz patch check synth bitstream load
# rebuild-load clean help) are defined once in sf-darfpga/tools/mk/machine.mk.
GAME         := <game>
SRC_DIR      := <src_dir>
TOP_ENTITY   := <TOP_ENTITY>
DISPLAY_NAME := <display_name>
IO_SUMMARY   := <io_summary>
DISPLAY_HINT := sw(13): 0 = 31 kHz VGA, 1 = 15 kHz TV

include ../tools/mk/machine.mk
