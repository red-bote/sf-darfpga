# Download zips fetched by download_darfpga.sh
/dloads/

# opencode project config — meta operational rules + terminology (see AGENTS.md)
#.opencode/

# Unzipped Dar source trees; covers the
# staged MAME ROMs and the shipped tool binaries inside them.
# Exceptions (re-included so they are visible/tracked): the tools/ tree, the
# <game>_unzip/ dirs, our make_<game>_proms.sh scripts, and the generated
# PROM VHDL (*.vhd). Each parent dir must be re-included before the file.
**/vhdl_*/*
!**/vhdl_*/tools/
**/vhdl_*/tools/*
!**/vhdl_*/tools/*_unzip/
**/vhdl_*/tools/*_unzip/*
!**/vhdl_*/tools/*_unzip/make_*_proms.sh

# Basys 3 port artifacts under each game's basys3/<game>_basys3/ dir (top
# wrapper, XDC, .xpr, imported MMCM IP + scandoubler) are tracked. Re-include
# the dir chain that **/vhdl_*/* ignores.
!**/vhdl_*/basys3/
!**/vhdl_*/basys3/*/

# Generated PROM VHDL is visible as untracked but is copyrighted MAME-derived
# content — never commit or stage it (convention-only; ROMs stay ignored).
!**/vhdl_*/tools/*_unzip/*.vhd

# Copyrighted MAME-derived content is never committed — extra safety net
*.zip
# Upstream Dar archives are tracked (2026-10-06); romset zips stay ignored.
!*/dloads/*.zip

# Vivado build junk (keep .xpr/.xdc/.vhd sources visible)
**/.runs/
**/.cache/
**/.gen/
**/.hw/
**/.sim/
**/.ip_user_files/
*.jou
*.log
*.str
*.wdb
