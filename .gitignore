# Download zips fetched by download_darfpga.sh
/dloads/

# opencode project config — meta operational rules + terminology (see AGENTS.md)
#.opencode/

# Unzipped Dar source trees, all generated by `make setup`: the upstream sources, the staged
# MAME ROMs, make_<game>_proms.sh (converted from the .bat by prep_roms.sh), the
# generated PROM VHDL and the Vivado project built in <SRC_DIR>/basys3/.
**/vhdl_*/*

# Copyrighted MAME-derived content is never committed — extra safety net
*.zip
# Upstream Dar archives are tracked (2026-10-06); romset zips stay ignored.
!*/dloads/*.zip

# Synthesis .vds copies and the per-build metrics row written by
# tools/lib/darfpga-bitstream.sh (local build-time study)
/build-logs/
/build-metrics.csv

# Vivado build output directories (<project>.runs etc.)
**/*.runs/
**/*.cache/
**/*.gen/
**/*.hw/
**/*.sim/
**/*.ip_user_files/
*.jou
*.log
*.str
*.wdb
