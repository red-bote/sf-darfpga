+  -- clock_div: PWM update enable, clock_40 / 10
+  process (reset, clock_40)
+  begin
+    if reset = '1' then
+      clock_div <= (others => '0');
+    else
+      if rising_edge(clock_40) then
+        if clock_div = "1001" then
+          clock_div <= (others => '0');
+        else
