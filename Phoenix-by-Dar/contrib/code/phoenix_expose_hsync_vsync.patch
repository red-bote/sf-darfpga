diff --git a/vhdl_phoenix_DE10_lite/rtl_dar/phoenix_video.vhd b/vhdl_phoenix_DE10_lite/rtl_dar/phoenix_video.vhd
--- a/vhdl_phoenix_DE10_lite/rtl_dar/phoenix_video.vhd
+++ b/vhdl_phoenix_DE10_lite/rtl_dar/phoenix_video.vhd
@@ -16,6 +16,8 @@
  hcnt     : out std_logic_vector(9 downto 1);
  vcnt     : out std_logic_vector(8 downto 1);
  sync     : out std_logic;
+ hsync    : out std_logic;
+ vsync    : out std_logic;
  adrsel   : out std_logic;
  rdy      : out std_logic;
  vblank       : out std_logic;
@@ -161,6 +163,10 @@
 adrsel <= vblank_n and hcnt_i(9);
 
 vblank       <= not vblank_n;
+-- real, separately-generated syncs for external scan-doubling; no RS-170
+-- serration needed here, that only exists for single-wire composite consumers.
+hsync <= pulse_a;   -- per-line pulse, active-low, fixed position every line
+vsync <= vblank_n;  -- already active-low during the 48-line vblank window
 hblank_frgrd <= hstb_i;
 hblank_bkgrd <= not(hcnt_i(9) and q1) and not(hcnt_i(9) and (q2));
 
diff --git a/vhdl_phoenix_DE10_lite/rtl_dar/phoenix.vhd b/vhdl_phoenix_DE10_lite/rtl_dar/phoenix.vhd
--- a/vhdl_phoenix_DE10_lite/rtl_dar/phoenix.vhd
