-process (reset, clock_24)
-begin
-	if reset='1' then
-		clock_div <= (others => '0');
-		clock_kbd  <= '0';
-	else 
-		if rising_edge(clock_24) then
-			if clock_div = "0010" then
-				clock_div <= (others => '0');
-				clock_kbd  <= not clock_kbd;
-			else
-				clock_div <= clock_div + '1';			
-			end if;
-		end if;
-	end if;
-end process;
