@@ -434,6 +435,16 @@
 	end if;
 end process;
 
+-- expose real hsync/vsync/pixel-clock-divider bits for an external
+-- scandoubler (composite-sync-only pristine design; hsync0 is a valid
+-- per-line pulse already, vsync is new simple logic independent of the
+-- vs_cnt equalizing-pulse scheme used for video_csync; clock_cnt(1:0)
+-- are the same bits pix_ena is built from -- clean 12/6 MHz square
+-- waves, exposed directly rather than re-derived downstream)
+video_hs <= hsync0;
+video_vs <= '0' when vcnt < 8 else '1';
+pix_clk_div <= clock_cnt(1 downto 0);
